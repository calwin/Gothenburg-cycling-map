# OpenRouteService API Key (Recommended)
# Get your FREE API key at: https://openrouteservice.org/dev/#/signup
# Free tier: 2,000 requests/day
#
# Benefits of adding this key:
# - Real elevation data and profiles
# - "Green" routing that prefers parks and quiet streets
# - Better cycling route options
# - More accurate travel times
#
# Without this key, the app falls back to OSRM (still works, but no elevation data)

VITE_ORS_API_KEY=your_api_key_here
